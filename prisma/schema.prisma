// JudicialSync — append-only event-ledger data model (Phase 1 scope: F0, F1, F2, F3).
//
// Design contract (see FRD Y0-schema.md / TechArch §3):
//   - ExhibitEvent is the SINGLE append-only ledger table — rows are NEVER
//     updated or deleted after creation. recordEvent() (Plan 2) is the only writer.
//   - *CurrentState tables are DERIVED projections, fully rebuildable by replaying
//     the ledger in sequenceNo order. They are never independently edited.
//   - Identity tables (Case, User, Exhibit) carry NO mutable status/custody fields.
//
// Prisma-side names are PascalCase/camelCase; @map/@@map pin the Postgres
// table/column names to snake_case per TechArch §3.8 ORM mapping.
//
// Phase 3 (F5/F6/F11) adds: DiscrepancyFlag, JuryPackage, JuryPackageExhibit
// (+ discrepancy_status / jury_package_status / jury_exhibit_discrepancy_status
// enums) — the cross-domain discrepancy engine and jury-package tables. Still
// out of scope (later phases): Assistant* models.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  JUDGE
  CHAMBERS_STAFF
  DEPUTY
  CLERK
  ATTORNEY
  ADMIN

  @@map("role_type")
}

enum OfferingParty {
  PLAINTIFF
  PROSECUTION
  DEFENSE

  @@map("offering_party")
}

enum ExhibitStatus {
  MARKED
  OFFERED
  OBJECTED
  ADMITTED
  EXCLUDED
  WITHDRAWN

  @@map("exhibit_status")
}

enum ObjectionStatus {
  UNRESOLVED
  SUSTAINED
  OVERRULED

  @@map("objection_status")
}

enum EventType {
  STATUS_CHANGE
  OBJECTION_RAISED
  RULING_RECORDED
  CUSTODY_TRANSFER
  DISCREPANCY_ACKNOWLEDGED

  @@map("event_type")
}

enum DiscrepancyStatus {
  OPEN
  ACKNOWLEDGED
  RESOLVED

  @@map("discrepancy_status")
}

enum JuryPackageStatus {
  DRAFT
  FINALIZED

  @@map("jury_package_status")
}

enum JuryExhibitDiscrepancyStatus {
  CLEAN
  FLAGGED

  @@map("jury_exhibit_discrepancy_status")
}

model Case {
  id         String   @id @default(uuid())
  caseNumber String   @unique @map("case_number")
  title      String
  court      String
  createdAt  DateTime @default(now()) @map("created_at")

  users            User[]
  exhibits         Exhibit[]
  discrepancyFlags DiscrepancyFlag[]
  juryPackages     JuryPackage[]
  conversations    AssistantConversation[]

  @@map("cases")
}

model User {
  id        String   @id @default(uuid())
  caseId    String   @map("case_id")
  name      String
  role      Role
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")

  case                  Case                    @relation(fields: [caseId], references: [id])
  actedEvents           ExhibitEvent[]          @relation("EventActor")
  custodyAssignments    CustodyCurrentState[]   @relation("CurrentCustodian")
  acknowledgedFlags     DiscrepancyFlag[]       @relation("DiscrepancyAcknowledger")
  finalizedJuryPackages JuryPackage[]           @relation("JuryPackageFinalizer")
  conversations         AssistantConversation[]

  @@index([caseId, role])
  @@map("users")
}

model Exhibit {
  id                String        @id @default(uuid())
  caseId            String        @map("case_id")
  exhibitLabel      String        @map("exhibit_label")
  description       String
  source            String?
  offeringParty     OfferingParty @map("offering_party")
  associatedWitness String?       @map("associated_witness")
  isSealed          Boolean       @default(false) @map("is_sealed")
  createdAt         DateTime      @default(now()) @map("created_at")

  case             Case                    @relation(fields: [caseId], references: [id])
  events           ExhibitEvent[]
  currentState     ExhibitCurrentState?
  custodyState     CustodyCurrentState?
  objections       ObjectionCurrentState[]
  discrepancyFlags DiscrepancyFlag[]
  juryPackageRows  JuryPackageExhibit[]

  @@unique([caseId, exhibitLabel])
  @@index([caseId])
  @@map("exhibits")
}

/// The single append-only ledger table. Rows are NEVER updated or deleted
/// after creation — enforced at the application layer: recordEvent() (Plan 2)
/// is the only writer. `sequenceNo` guarantees deterministic per-exhibit
/// replay order independent of clock skew.
model ExhibitEvent {
  id          String    @id @default(uuid())
  exhibitId   String    @map("exhibit_id")
  caseId      String    @map("case_id")
  eventType   EventType @map("event_type")
  payload     Json
  actorUserId String    @map("actor_user_id")
  sequenceNo  Int       @map("sequence_no")
  recordedAt  DateTime  @default(now()) @map("recorded_at")

  exhibit Exhibit @relation(fields: [exhibitId], references: [id])
  actor   User    @relation("EventActor", fields: [actorUserId], references: [id])

  acknowledgedFlags DiscrepancyFlag[] @relation("DiscrepancyAckEvent")
  resolvedFlags     DiscrepancyFlag[] @relation("DiscrepancyResolveEvent")

  @@unique([exhibitId, sequenceNo])
  @@index([exhibitId, recordedAt])
  @@index([caseId, eventType, recordedAt])
  @@map("exhibit_events")
}

/// One row per exhibit once it has at least one STATUS_CHANGE event.
/// Fully rebuildable by replaying exhibit_events WHERE event_type =
/// STATUS_CHANGE in sequence_no order (see Plan 7, rebuildProjections).
model ExhibitCurrentState {
  exhibitId         String        @id @map("exhibit_id")
  currentStatus     ExhibitStatus @map("current_status")
  lastStatusEventId String        @map("last_status_event_id")
  lastStatusAt      DateTime      @map("last_status_at")

  exhibit Exhibit @relation(fields: [exhibitId], references: [id])

  @@map("exhibit_current_state")
}

/// One row per objection THREAD (not per exhibit — an exhibit may have many
/// concurrently open threads). Rebuildable by replaying OBJECTION_RAISED /
/// RULING_RECORDED events grouped by payload.objectionId.
model ObjectionCurrentState {
  objectionId    String          @id @map("objection_id")
  exhibitId      String          @map("exhibit_id")
  status         ObjectionStatus @default(UNRESOLVED)
  objectingParty OfferingParty   @map("objecting_party")
  grounds        String
  raisedEventId  String          @map("raised_event_id")
  raisedAt       DateTime        @map("raised_at")
  rulingEventId  String?         @map("ruling_event_id")
  ruledAt        DateTime?       @map("ruled_at")

  exhibit Exhibit @relation(fields: [exhibitId], references: [id])

  @@index([exhibitId, status])
  @@map("objection_current_state")
}

/// One row per exhibit once it has at least one CUSTODY_TRANSFER event.
/// An exhibit with NO row here despite being ADMITTED is exactly the
/// ADMITTED_NO_CUSTODIAN discrepancy condition evaluated by Phase 3 —
/// absence is meaningful and must never be backfilled with a placeholder row.
model CustodyCurrentState {
  exhibitId              String   @id @map("exhibit_id")
  currentCustodianUserId String   @map("current_custodian_user_id")
  since                  DateTime
  lastEventId            String   @map("last_event_id")

  exhibit   Exhibit @relation(fields: [exhibitId], references: [id])
  custodian User    @relation("CurrentCustodian", fields: [currentCustodianUserId], references: [id])

  @@map("custody_current_state")
}

/// Phase 3 (F6). A cross-domain discrepancy detected by the rule engine
/// (src/services/discrepancies.ts), keyed by (exhibitId, ruleCode). Created
/// OPEN the instant an exhibit's derived state crosses a rule threshold, moved
/// to RESOLVED in the same write when the condition clears, or ACKNOWLEDGED by
/// an authorized user via an auditable DISCREPANCY_ACKNOWLEDGED ledger event.
/// `details` captures the mismatch snapshot at detection time.
model DiscrepancyFlag {
  id                  String            @id @default(uuid())
  caseId              String            @map("case_id")
  exhibitId           String            @map("exhibit_id")
  ruleCode            String            @map("rule_code")
  status              DiscrepancyStatus @default(OPEN)
  detectedAt          DateTime          @default(now()) @map("detected_at")
  details             Json
  acknowledgedAt      DateTime?         @map("acknowledged_at")
  acknowledgedBy      String?           @map("acknowledged_by")
  acknowledgedEventId String?           @map("acknowledged_event_id")
  resolvedAt          DateTime?         @map("resolved_at")
  resolvedByEventId   String?           @map("resolved_by_event_id")

  case               Case          @relation(fields: [caseId], references: [id])
  exhibit            Exhibit       @relation(fields: [exhibitId], references: [id])
  acknowledgedByUser User?         @relation("DiscrepancyAcknowledger", fields: [acknowledgedBy], references: [id])
  acknowledgedEvent  ExhibitEvent? @relation("DiscrepancyAckEvent", fields: [acknowledgedEventId], references: [id])
  resolvedByEvent    ExhibitEvent? @relation("DiscrepancyResolveEvent", fields: [resolvedByEventId], references: [id])

  @@index([caseId, status], map: "idx_discrepancy_flags_case_status")
  @@index([exhibitId, ruleCode], map: "idx_discrepancy_flags_exhibit_rule")
  @@map("discrepancy_flags")
}

/// Phase 3 (F5). A jury-ready package for a case. Starts DRAFT; finalizing it
/// snapshots the eligible exhibits into JuryPackageExhibit rows (plan 03-02).
model JuryPackage {
  id          String            @id @default(uuid())
  caseId      String            @map("case_id")
  status      JuryPackageStatus @default(DRAFT)
  createdAt   DateTime          @default(now()) @map("created_at")
  finalizedAt DateTime?         @map("finalized_at")
  finalizedBy String?           @map("finalized_by")

  case            Case                 @relation(fields: [caseId], references: [id])
  finalizedByUser User?                @relation("JuryPackageFinalizer", fields: [finalizedBy], references: [id])
  exhibits        JuryPackageExhibit[]

  @@index([caseId, status], map: "idx_jury_packages_case_status")
  @@map("jury_packages")
}

/// Phase 3 (F5). One exhibit's membership in a jury package, with the
/// discrepancy posture captured at finalize time (CLEAN vs FLAGGED).
model JuryPackageExhibit {
  id                String                       @id @default(uuid())
  juryPackageId     String                       @map("jury_package_id")
  exhibitId         String                       @map("exhibit_id")
  discrepancyStatus JuryExhibitDiscrepancyStatus @map("discrepancy_status")
  addedAt           DateTime                     @default(now()) @map("added_at")

  juryPackage JuryPackage @relation(fields: [juryPackageId], references: [id])
  exhibit     Exhibit     @relation(fields: [exhibitId], references: [id])

  @@unique([juryPackageId, exhibitId], map: "uq_jury_package_exhibit")
  @@map("jury_package_exhibits")
}

// --- Pivota Assistant (F7) ---

enum MessageRole {
  USER
  ASSISTANT

  @@map("message_role")
}

model AssistantConversation {
  id        String   @id @default(uuid())
  caseId    String   @map("case_id")
  userId    String   @map("user_id")
  startedAt DateTime @default(now()) @map("started_at")

  case     Case               @relation(fields: [caseId], references: [id])
  user     User               @relation(fields: [userId], references: [id])
  messages AssistantMessage[]

  @@map("assistant_conversations")
}

model AssistantMessage {
  id             String      @id @default(uuid())
  conversationId String      @map("conversation_id")
  role           MessageRole
  content        String
  createdAt      DateTime    @default(now()) @map("created_at")

  conversation AssistantConversation @relation(fields: [conversationId], references: [id])
  citations    AssistantCitation[]

  @@index([conversationId, createdAt])
  @@map("assistant_messages")
}

model AssistantCitation {
  id         String   @id @default(uuid())
  messageId  String   @map("message_id")
  recordType String   @map("record_type")
  recordId   String   @map("record_id")
  exhibitId  String   @map("exhibit_id") // ADDITIVE (beyond TechArch): deep-link target exhibit
  eventId    String?  @map("event_id") // ADDITIVE, NULLABLE: timeline anchor when one exists
  timestamp  DateTime
  label      String

  message AssistantMessage @relation(fields: [messageId], references: [id])

  @@index([messageId])
  @@map("assistant_citations")
}
