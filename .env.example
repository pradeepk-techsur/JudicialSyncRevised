# Copy this file to `.env` for local development:  cp .env.example .env
# The password below is a dev-only placeholder — never a production secret.
# Production (Neon) credentials are supplied via Vercel environment variables.
DATABASE_URL="postgresql://judicialsync:judicialsync_dev@localhost:5432/judicialsync"

# --- Demo role switcher (T-09) — public, build-time client flag ---
# This app is a DEMO: the header's role switcher changes the active persona with
# NO real authentication behind it. The switcher is gated on this flag so a
# hypothetical future production deployment (with real auth in front of it) can
# hide the switcher without a code change. It defaults to ENABLED: the switcher
# renders unless this is set to the literal string 'false'. Leave it unset (or
# 'true') for the demo — matching current shipped behavior. Only a genuine
# production build with real login should set it to 'false'.
NEXT_PUBLIC_DEMO_MODE="true"

# --- Pivota Assistant (F7) — Anthropic LLM, server-side only ---
# Get a key at https://console.anthropic.com/settings/keys
# With this left as the placeholder (or unset), the app still boots and every
# screen works; the assistant returns 503 "temporarily unavailable" (criterion 5).
ANTHROPIC_API_KEY="sk-ant-REPLACE_ME"
# Optional: override the pinned Claude Sonnet model id.
# ANTHROPIC_MODEL="claude-sonnet-4-5"
